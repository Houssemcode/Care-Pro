<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="p6yl_gt88V00AqKUax_J">
    <mxGraphModel dx="2240" dy="1289" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Class Diagram - Entity Relationship\nskinparam componentStyle rectangle\n\nentity User {\n  + id: BIGINT UNSIGNED\n  + name: VARCHAR\n  + email: VARCHAR\n  + phone: VARCHAR\n  + email_verified_at: TIMESTAMP\n  + password: VARCHAR\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Admin {\n  + id: BIGINT UNSIGNED\n  + user_id: BIGINT UNSIGNED\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Employee {\n  + id: BIGINT UNSIGNED\n  + user_id: BIGINT UNSIGNED\n  + experience: VARCHAR\n  + diploma: VARCHAR\n  + description: VARCHAR\n  + status: ENUM {pending, active, suspended}\n  + total_points: INT\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Family {\n  + id: BIGINT UNSIGNED\n  + user_id: BIGINT UNSIGNED\n  + status: ENUM {active, suspended}\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Localization {\n  + id: BIGINT UNSIGNED\n  + user_id: BIGINT UNSIGNED\n  + wilaya: VARCHAR\n  + commune: VARCHAR\n  + latitude: DOUBLE\n  + logitude: DOUBLE\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Report {\n  + id: BIGINT UNSIGNED\n  + admin_id: BIGINT UNSIGNED\n  + employee_id: BIGINT UNSIGNED\n  + family_id: BIGINT UNSIGNED\n  + reporter_type: ENUM {family, employee}\n  + report_reason: VARCHAR\n  + description: TEXT\n  + status: ENUM {active, resolved}\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity EmployeeDocument {\n  + id: BIGINT UNSIGNED\n  + employee_id: BIGINT UNSIGNED\n  + document_type: ENUM {id_card, certificate, criminal_record, medical_certificate, resume}\n  + file_path: VARCHAR\n  + points: INT\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity Offre {\n  + id: BIGINT UNSIGNED\n  + employee_id: BIGINT UNSIGNED\n  + wilaya: VARCHAR\n  + commune: VARCHAR\n  + service_type: ENUM {Child Care, Elderly Care}\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n  ---\n  + working_house: TINYINT(1)\n}\n\nentity Request {\n  + id: BIGINT UNSIGNED\n  + family_id: BIGINT UNSIGNED\n  + offre_id: BIGINT UNSIGNED\n  + start_date: DATETIME\n  + end_date: DATETIME\n  + status: ENUM {pending, assigned, rejected}\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity AssignmentService {\n  + id: BIGINT UNSIGNED\n  + family_id: BIGINT UNSIGNED\n  + offre_id: BIGINT UNSIGNED\n  + assigned_at: DATETIME\n  + start_date: DATE\n  + end_date: DATE\n  + status: ENUM {active, completed, cancelled}\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n  ---\n  + price: DECIMAL(8, 2)\n}\n\nentity Rating {\n  + id: BIGINT UNSIGNED\n  + assignment_service_id: BIGINT UNSIGNED\n  + stars: INT\n  + comment: TEXT\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\nentity BookingMessage {\n  + id: BIGINT UNSIGNED\n  + request_id: BIGINT UNSIGNED\n  + user_id: BIGINT UNSIGNED\n  + message: TEXT\n  + created_at: TIMESTAMP\n  + updated_at: TIMESTAMP\n}\n\n&#39; Relationships\n\n&#39; Inheritance\nUser &lt;|-- Family\nUser &lt;|-- Admin\nUser &lt;|-- Employee\n\n&#39; User to Localization\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Localization\n\n&#39; Reports\nFamily \&quot;1\&quot; -- \&quot;0..*\&quot; Report\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; Report\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; Report\n\n&#39; Employee Details\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; EmployeeDocument\nEmployee \&quot;1\&quot; -- \&quot;0..*\&quot; Offre\n\n&#39; Requests\nFamily \&quot;1\&quot; -- \&quot;0..*\&quot; Request\nOffre \&quot;1\&quot; -- \&quot;0..*\&quot; Request\n\n&#39; Assignment Services\nFamily \&quot;1\&quot; -- \&quot;0..*\&quot; AssignmentService\nRequest \&quot;1\&quot; .. \&quot;1\&quot; AssignmentService\n\n&#39; Ratings\nAssignmentService \&quot;1\&quot; -- \&quot;0..1\&quot; Rating\nFamily \&quot;1\&quot; -- \&quot;0..*\&quot; Rating\n\n&#39; Booking Messages\nRequest \&quot;1\&quot; -- \&quot;0..*\&quot; BookingMessage\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; BookingMessage\n\n@enduml&quot;,&quot;format&quot;:&quot;png&quot;}" id="K-Cew5UsvgHJi8CojJTP-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1">
            <mxGeometry height="1401" width="1893" x="20" y="7" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Sequence Diagram - Booking Lifecycle\n  actor Family\n  actor Employee\n  participant \&quot;Request System\&quot; as System\n  participant \&quot;Assignment System\&quot; as Assignment\n\n  Family -&gt; System: Create Request for specific Offre\n  System -&gt; Employee: Notify of new Request\n  Employee -&gt; System: Review Request\n  alt Accept Request\n      Employee -&gt; System: Update status to &#39;assigned&#39;\n      Family -&gt; Assignment: Agree on Price &amp; Dates\n      Assignment -&gt; Assignment: Create AssignmentService (Active)\n  else Reject Request\n      Employee -&gt; System: Update status to &#39;rejected&#39;\n      System -&gt; Family: Notify Rejection\n  end\n\n  Employee -&gt; Assignment: Mark Service as &#39;completed&#39;\n  Family -&gt; System: Submit Rating &amp; Comment\n  @enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="K-Cew5UsvgHJi8CojJTP-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="551" width="681" x="1140" y="1478" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Use Case Diagram - Care-Pro\nleft to right direction\n\n&#39; Define Actors\nactor \&quot;General User\&quot; as user\nactor \&quot;Family\&quot; as family\nactor \&quot;Employee\&quot; as employee\nactor \&quot;Admin\&quot; as admin\n\n&#39; Set up Inheritance (Family and Employee are both Users)\nuser &lt;|-- family\nuser &lt;|-- employee\n\nrectangle \&quot; \&quot; {\n  usecase \&quot;Register\&quot; as UC9\n  usecase \&quot;Login\&quot; as UC10\n  usecase \&quot;Profile Monitoring\&quot; as UC11\n  \n  usecase \&quot;Consult Offers\&quot; as UC1\n  usecase \&quot;Send Request\&quot; as UC2\n  usecase \&quot;Create Offers\&quot; as UC4\n  usecase \&quot;Consult Requests\&quot; as UC12\n  usecase \&quot;Respond to Requests\&quot; as UC6\n  \n  usecase \&quot;Rate Employee\&quot; as UC3\n  usecase \&quot;Send Reports\&quot; as UC13\n  usecase \&quot;Send Documents\&quot; as UC5\n  \n  usecase \&quot;Verify Employees\&quot; as UC7\n  usecase \&quot;Resolve Reports\&quot; as UC8\n  usecase \&quot;System Data Monitoring\&quot; as UC14\n}\n\n&#39; Shared relationships (reduces line clutter)\nuser --&gt; UC9\nuser --&gt; UC10\nuser --&gt; UC11\n\n&#39; Family relationships\nfamily --&gt; UC1\nfamily --&gt; UC2\nfamily --&gt; UC3\nfamily --&gt; UC13\n\n&#39; Employee relationships\nemployee --&gt; UC4\nemployee --&gt; UC12\nemployee --&gt; UC6\nemployee --&gt; UC5\n\n&#39; Admin relationships\nadmin --&gt; UC7\nadmin --&gt; UC8\nadmin --&gt; UC14\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="K-Cew5UsvgHJi8CojJTP-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="999" width="465" x="2090" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\ntitle Activity Diagram - Employee Verification Flow\nstart\n:Employee registers account;\n:Uploads Identification &amp; Diplomas;\n:Status set to &#39;Pending&#39;;\n:Admin receives notification;\nif (Documents Valid?) then (yes)\n  :Set status to &#39;Active&#39;;\n  :Allow creation of Service Offerings;\n  stop\nelse (no)\n  :Set status to &#39;Suspended&#39;;\n  :Notify Employee of rejection;\n  stop\nendif\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="K-Cew5UsvgHJi8CojJTP-6">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="470" width="460" x="1830" y="1070" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
